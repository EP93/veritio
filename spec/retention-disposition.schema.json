{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getveritio.com/spec/retention-disposition.schema.json",
  "title": "Veritio Retention Disposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType", "schemaVersion", "dispositionId", "tenantId", "chainKind",
    "checkpointHash", "fromSequence", "throughSequence", "archiveRootHash",
    "method", "policyReference", "disposedAt", "canonicalization", "hashAlgorithm", "hash"
  ],
  "properties": {
    "recordType": { "const": "retention.disposition" },
    "schemaVersion": { "const": "1.0" },
    "dispositionId": { "$ref": "#/$defs/id" },
    "tenantId": { "$ref": "#/$defs/id" },
    "chainKind": { "const": "audit" },
    "checkpointHash": { "$ref": "#/$defs/hash" },
    "fromSequence": { "$ref": "#/$defs/positiveSafeInteger" },
    "throughSequence": { "$ref": "#/$defs/positiveSafeInteger" },
    "archiveRootHash": { "$ref": "#/$defs/hash" },
    "method": { "const": "provider-delete" },
    "policyReference": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$" },
    "disposedAt": { "$ref": "#/$defs/timestamp" },
    "canonicalization": { "const": "veritio-json-v1" },
    "hashAlgorithm": { "const": "sha256" },
    "signaturePublicKeyFingerprint": { "$ref": "#/$defs/hash" },
    "hash": { "$ref": "#/$defs/hash" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "allOf": [
    {
      "if": { "required": ["signaturePublicKeyFingerprint"] },
      "then": { "required": ["signature"] },
      "else": { "not": { "required": ["signature"] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "positiveSafeInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "publicKeyFingerprint", "signature"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "publicKeyFingerprint": { "$ref": "#/$defs/hash" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    }
  }
}
