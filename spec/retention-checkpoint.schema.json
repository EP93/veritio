{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getveritio.com/spec/retention-checkpoint.schema.json",
  "title": "Veritio Retention Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType", "schemaVersion", "checkpointId", "tenantId", "chainKind",
    "epoch", "fromSequence", "fromPreviousHash", "throughSequence", "throughHash",
    "recordCount", "archiveRootHash", "previousCheckpointHash", "createdAt",
    "canonicalization", "hashAlgorithm", "hash"
  ],
  "properties": {
    "recordType": { "const": "retention.checkpoint" },
    "schemaVersion": { "const": "1.0" },
    "checkpointId": { "$ref": "#/$defs/id" },
    "tenantId": { "$ref": "#/$defs/id" },
    "chainKind": { "const": "audit" },
    "epoch": { "$ref": "#/$defs/positiveSafeInteger" },
    "fromSequence": { "$ref": "#/$defs/positiveSafeInteger" },
    "fromPreviousHash": { "$ref": "#/$defs/nullableHash" },
    "throughSequence": { "$ref": "#/$defs/positiveSafeInteger" },
    "throughHash": { "$ref": "#/$defs/hash" },
    "recordCount": { "$ref": "#/$defs/positiveSafeInteger" },
    "archiveRootHash": { "$ref": "#/$defs/hash" },
    "previousCheckpointHash": { "$ref": "#/$defs/nullableHash" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "canonicalization": { "const": "veritio-json-v1" },
    "hashAlgorithm": { "const": "sha256" },
    "signaturePublicKeyFingerprint": { "$ref": "#/$defs/hash" },
    "hash": { "$ref": "#/$defs/hash" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "allOf": [
    {
      "if": { "required": ["signaturePublicKeyFingerprint"] },
      "then": { "required": ["signature"] },
      "else": { "not": { "required": ["signature"] } }
    },
    {
      "if": { "properties": { "epoch": { "const": 1 } }, "required": ["epoch"] },
      "then": {
        "properties": {
          "fromSequence": { "const": 1 },
          "fromPreviousHash": { "type": "null" },
          "previousCheckpointHash": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "fromPreviousHash": { "$ref": "#/$defs/hash" },
          "previousCheckpointHash": { "$ref": "#/$defs/hash" }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "positiveSafeInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29|(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "publicKeyFingerprint", "signature"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "publicKeyFingerprint": { "$ref": "#/$defs/hash" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    }
  }
}
